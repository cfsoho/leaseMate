# .env.example
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
POSTGRES_DB=example_db
DATABASE_URL=postgresql+psycopg2://example_user:example_password@db:5432/example_db
PGADMIN_DEFAULT_EMAIL=admin@leasemate.com
PGADMIN_DEFAULT_PASSWORD=change_this_pgadmin_password
SECRET_KEY=your_secret_key_here
AUTO_CREATE_TABLES=false
APP_PUBLIC_URL=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=15
EMAIL_CONFIRMATION_EXPIRE_HOURS=24
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_NOREPLY_USER=noreply@leasemate.cfsoho.com
SMTP_NOREPLY_PASSWORD=google_app_password
SMTP_NOREPLY_FROM=noreply@leasemate.cfsoho.com
SMTP_SYSTEM_USER=system@leasemate.cfsoho.com
SMTP_SYSTEM_PASSWORD=google_app_password
SMTP_SYSTEM_FROM=system@leasemate.cfsoho.com
